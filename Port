<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alade Israel Anuoluwapo - Digital Portfolio</title>
    <style>
        :root {
            --bg-body: #111827; /* Dark Gray */
            --bg-card: #1f2937; /* Lighter Gray for cards */
            --accent-primary: #ec4899; /* Vibrant Pink */
            --accent-secondary: #facc15; /* Bright Yellow */
            --text-main: #f9fafb; /* Off-White */
            --text-muted: #d1d5db; /* Gray-White */
            --border: #374151; /* Border gray */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            line-height: 1.7;
            padding: 1rem;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        /* --- Colorful Header --- */
        header {
            text-align: center;
            padding: 4rem 2rem;
            background: linear-gradient(135deg, var(--bg-card) 0%, #171c26 100%);
            border: 1px solid var(--border);
            border-radius: 20px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3);
        }

        header::before {
            content: "";
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 6px;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
        }

        /* Profile Picture Style */
        .profile-pic {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 4px solid var(--accent-primary);
            object-fit: cover;
            margin-bottom: 1.5rem;
            box-shadow: 0 0 20px var(--accent-primary);
        }

        h1 {
            font-size: 2.8rem;
            letter-spacing: -0.05em;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-size: 1.3rem;
            color: var(--accent-secondary);
            font-weight: 600;
            margin-bottom: 1.5rem;
            letter-spacing: 0.05em;
        }

        .bio {
            color: var(--text-muted);
            max-width: 650px;
            margin: 0 auto 2rem auto;
            font-size: 1rem;
        }

        /* Colorful Buttons */
        .links {
            display: flex;
            justify-content: center;
            gap: 1.2rem;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            color: #111827;
            text-decoration: none;
            font-weight: 700;
            border-radius: 30px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            font-size: 1rem;
            letter-spacing: 0.02em;
        }

        .btn-vibrant {
            background: linear-gradient(90deg, var(--accent-primary), #d946ef);
            color: white;
            box-shadow: 0 4px 10px rgba(236, 72, 153, 0.4);
        }

        .btn-vibrant:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(236, 72, 153, 0.6);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--accent-secondary);
            border: 2px solid var(--accent-secondary);
        }

        .btn-outline:hover {
            background-color: var(--accent-secondary);
            color: #111827;
        }

        /* --- Content Sections --- */
        section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 2.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

        h2 {
            font-size: 1.6rem;
            color: var(--accent-primary);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        h2::after {
            content: "";
            flex: 1;
            height: 2px;
            background: linear-gradient(90deg, var(--border), rgba(55, 65, 81, 0.1));
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        @media(min-width: 650px) {
            .grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        .card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            padding: 1.5rem;
            border-radius: 12px;
            transition: border-color 0.2s ease;
        }

        .card:hover {
            border-color: var(--accent-primary);
        }

        .card h3 {
            font-size: 1.1rem;
            color: var(--accent-secondary);
            margin-bottom: 0.5rem;
        }

        .card p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .edu-item {
            margin-bottom: 1.5rem;
        }

        .edu-title {
            color: var(--text-main);
            font-weight: 600;
        }

        .edu-meta {
            color: var(--accent-secondary);
            font-size: 0.9rem;
        }

        footer {
            text-align: center;
            padding: 3rem 0;
            color: var(--text-muted);
            font-size: 0.9rem;
            border-top: 1px solid var(--border);
            margin-top: 2rem;
        }
    </style>
</head>
